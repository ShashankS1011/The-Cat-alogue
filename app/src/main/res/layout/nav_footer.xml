<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@color/dark_surface_variant">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="60+ Feline Breeds • Offline Ready"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@color/primary_gold"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="The Cat-alogue v1.0.0"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/on_dark_surface_secondary" />

</LinearLayout>
